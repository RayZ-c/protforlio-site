# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Vite / VitePress build output
dist
docs/.vitepress/dist

# Local environment / config
.env
.env.local
.env.*.local

# Editor / OS junk
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
*.swo

# Logs
logs
*.log

# VitePress local cache — build artefact, must not be committed
.vitepress/cache
.vitepress/dist

# Visual Studio editor state
.vs/

# Local-only comparison/scratch pages served out of public/
public/_lab/
public/_compare/

# Playwright MCP scratch output
.playwright-mcp/

# Local-only secrets & notes — never commit.
# Anything matching *.local.* stays on this machine. The Discord webhook lives in
# project-context/notify.local.md and is a credential: whoever has that URL can
# post to the channel.
*.local.md
*.local.json
project-context/notify.local.md

# VitePress SSR scratch output. Regenerated on every build; 151 MB of duplicated
# video/posters got committed once because this rule was missing.
.vitepress/.temp
